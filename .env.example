# ============================================================
# NexoCRM — Variables de entorno
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# ============================================================

# ---------- Base de datos ----------
# SQLite (por defecto, cero configuración para desarrollo local).
# La ruta relativa se resuelve desde prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# PostgreSQL (producción) — cambia el provider a "postgresql" en
# prisma/schema.prisma y usa una URL como esta:
# DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/nexocrm?schema=public"

# ---------- Seguridad ----------
# Secreto para firmar las cookies de sesión (HMAC-SHA256).
# Genera uno fuerte con:  openssl rand -hex 32
AUTH_SECRET="cambia-este-secreto-en-produccion"
