# ============================================================
# NexoCRM — .gitignore
# ============================================================

# ---------- Dependencias ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Next.js ----------
/.next/
/out/
/build
.vercel

# ---------- Entorno y secretos ----------
.env
.env.*
!.env.example
*.pem

# ---------- Base de datos local (SQLite) ----------
/db/
prisma/dev.db*
prisma/*.db-journal

# ---------- Logs y depuración ----------
*.log
dev.log
server.log
dev.out.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- TypeScript ----------
*.tsbuildinfo
next-env.d.ts

# ---------- Sistema / editores ----------
.DS_Store
.idea/
.vscode/
*.swp

# ---------- Infraestructura del sandbox (no forma parte del producto) ----------
/.zscripts/
/Caddyfile
/download/
/upload/
/examples/
/mini-services/
/tests/*.sh
/skills/
/.claude
/.z-ai-config
/.z-ai-*
local-*
prompt
test
